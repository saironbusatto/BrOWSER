{
  "name": "browser",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "form": "bun run --cwd fixtures/form dev",
    "spike": "bun scripts/spike.ts",
    "typecheck": "bun run --cwd packages/extension tipos && tsc -p tsconfig.json && tsc -p packages/extension",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "verificar": "bun run lint && bun run typecheck && bun test",
    "teia:visual": "bun packages/extension/scripts/teia-visual.ts",
    "grupo:real": "bun packages/extension/scripts/grupo-abas-real.ts"
  },
  "dependencies": {
    "@browser/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@types/bun": "^1.4.2",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0",
    "rcedit": "5.0.2",
    "typescript": "^7.0.2"
  }
}
